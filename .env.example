DEBUG=True
DJANGO_DEBUG=True
SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
DB_CONN_MAX_AGE=60
FRONTEND_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
TIME_ZONE=Asia/Dhaka

# Render production values. DATABASE_URL must be the pooled Neon PostgreSQL URL;
# Render forces Django DEBUG off and therefore always uses these services.
# Keep Neon's sslmode=require and channel_binding=require query parameters.
# DATABASE_URL=postgresql://USER:PASSWORD@NEON_POOLER_HOST/DATABASE?sslmode=require&channel_binding=require
# ALLOWED_HOSTS=local-mart-11yd.onrender.com
# FRONTEND_URL=https://golocalmart.vercel.app
# BACKEND_BASE_URL=https://local-mart-11yd.onrender.com
# CORS_ALLOWED_ORIGINS=https://golocalmart.vercel.app
# CSRF_TRUSTED_ORIGINS=https://golocalmart.vercel.app

# Stripe (optional for startup; required to enable Stripe payments)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=bdt

# Storage switches automatically: DEBUG=True uses local media and DEBUG=False
# uses Cloudinary. In production, set either CLOUDINARY_URL or all three values.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Production security overrides
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
