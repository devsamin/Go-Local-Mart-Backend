DEBUG=True
SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
DB_CONN_MAX_AGE=60
FRONTEND_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
TIME_ZONE=Asia/Dhaka

# Render production values. DATABASE_URL must be a PostgreSQL connection string;
# the application intentionally refuses to start with SQLite on Render.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# ALLOWED_HOSTS=local-mart-11yd.onrender.com
# FRONTEND_URL=https://golocalmart.vercel.app
# BACKEND_BASE_URL=https://local-mart-11yd.onrender.com
# CORS_ALLOWED_ORIGINS=https://golocalmart.vercel.app
# CSRF_TRUSTED_ORIGINS=https://golocalmart.vercel.app

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=bdt

# Cloudinary (mandatory and automatic on Render; set True on other production hosts)
USE_CLOUDINARY=False
# In production, set either CLOUDINARY_URL or all three values below.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Temporary compatibility for media files committed before Cloudinary was enabled.
# This defaults to True on Render and can be disabled after legacy media is migrated.
SERVE_LOCAL_MEDIA=False
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Production security overrides
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
